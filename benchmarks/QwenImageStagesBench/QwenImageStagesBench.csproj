<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QwenImageStagesBench</AssemblyName>
    <Description>Qwen-Image-2.1 companion-stage harness: text encoder, vision encoder, VAE encode and VAE decode timed on the pure-C# cpu backend and on ggml_cpu, with F32 dumps and a parity comparer, plus a VAE convolution-layer microbenchmark for the managed packed GEMM.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\TensorSharp.Models\TensorSharp.Models.csproj" />
    <ProjectReference Include="..\..\TensorSharp.Backends.GGML\TensorSharp.Backends.GGML.csproj" />
  </ItemGroup>
</Project>
