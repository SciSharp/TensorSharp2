<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AssemblyName>QwenImageDiTBench</AssemblyName>
    <Description>Parity and timing of the Qwen-Image-2.1 transformer on the pure-C# cpu backend against the native ggml_cpu graph: identical inputs, velocity cosine / rel-L2 / max-abs and per-forward time, with and without the prefix KV cache, a LoRA and an edit layout.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\TensorSharp.Models\TensorSharp.Models.csproj" />
  </ItemGroup>
</Project>
